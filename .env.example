# Copy to .env for local testing. None of these are secrets.
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application) → Client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# iPhone builds only (OAuth client of type iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Published with the web app
EXPO_PUBLIC_PRIVACY_URL=https://drnvskrishnareddy.github.io/sakhi-samachar/privacy.html
EXPO_PUBLIC_UPDATE_URL=https://drnvskrishnareddy.github.io/sakhi-samachar/version.json
